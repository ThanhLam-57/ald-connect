# Existing Workforce revenue API, configured on the Connect server only.
WORKFORCE_ORIGIN=
ALD_REVENUE_API_TOKEN=

# Optional. Defaults to .data/connect.sqlite on the machine running Connect.
ALD_CONNECT_DB_PATH=
# Optional public URL for activation links and same-origin checks behind a proxy.
CONNECT_PUBLIC_URL=
# Optional path prefix, set before building Connect.
NEXT_PUBLIC_CONNECT_BASE_PATH=
